# =============================================================================
#  Stadion-Intercom – zentrale Konfiguration
#  Wird von docker-compose.yml und vom Admin-Container gelesen.
#  ACHTUNG: Diese Datei enthaelt Secrets. Nicht ins Git!  (siehe .gitignore)
#  Alle Werte, die mit ERSETZEN_ beginnen, werden von ./setup.sh automatisch
#  durch `openssl rand -base64 24` ersetzt.
# =============================================================================

# --- Mumble-Server -----------------------------------------------------------
# MUMBLE_VERSION ist die EINZIGE Versionsquelle: sie bestimmt sowohl den Tag des
# Server-Images als auch den Tag, aus dem MumbleServer.ice fuer das Admin-Image
# geladen wird. Damit koennen Slice und Server nicht auseinanderlaufen.
MUMBLE_VERSION=v1.5.735
MUMBLE_PORT=64738
MUMBLE_SUPERUSER_PASSWORD=ERSETZEN

# --- Ice (Server-Schnittstelle) ---------------------------------------------
# Ice lauscht bewusst nur auf dem Loopback. Beide Container laufen im Host-Netz,
# daher ist 127.0.0.1 fuer beide dieselbe Adresse.  Siehe DECISIONS.md (D-002).
ICE_HOST=127.0.0.1
ICE_PORT=6502
ICE_SECRET=ERSETZEN
ICE_SERVER_ID=1

# --- Admin-GUI ---------------------------------------------------------------
# Das Cockpit liefert nur HTTP -- Passwort und Sitzungscookie gehen im Klartext
# ueber das Netz. Im abgeschlossenen Stadionnetz vertretbar, sonst einen Reverse
# Proxy mit TLS davorsetzen.
#
# LISTEN_HOST ist die erste Absicherung: die IP der Netzkarte eintragen, die im
# Stadionnetz haengt (z. B. 10.20.10.5). Dann ist der Port auf allen anderen
# Schnittstellen gar nicht erst offen. 0.0.0.0 heisst: ueberall erreichbar.
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
ADMIN_USER=admin
ADMIN_PASSWORD=ERSETZEN
# Optionaler zweiter, nur lesender Account. Leer lassen = deaktiviert.
ADMIN_READONLY_USER=viewer
ADMIN_READONLY_PASSWORD=ERSETZEN
SESSION_SECRET=ERSETZEN

# --- Provisioning ------------------------------------------------------------
INTERCOM_CONFIG=/config/intercom.yaml
PROVISION_ON_START=true
# true => Kanaele/Gruppen, die NICHT in der YAML stehen, werden geloescht.
# Default false: der Plan zeigt sie trotzdem als "wuerde geloescht" an.
PROVISION_PRUNE=false

# --- Monitor-Bot -------------------------------------------------------------
MONITOR_BOT_ENABLED=true
MONITOR_BOT_NAME=monitor
MONITOR_BOT_CHANNEL=Intercom/Regie
# Passwort nur noetig, wenn der Bot ohne Zertifikat registriert wird.
MONITOR_BOT_PASSWORD=
MONITOR_BOT_CERT=/data/monitor-cert.pem
MONITOR_STATS_INTERVAL_MS=5000

# --- Polling / Verlauf / Alarme ---------------------------------------------
POLL_INTERVAL_MS=2000
HISTORY_RETENTION_HOURS=48
ALERT_PING_MS=80
ALERT_LOSS_PCT=2.0

# --- Sonstiges ---------------------------------------------------------------
LOG_LEVEL=INFO
TZ=Europe/Berlin
