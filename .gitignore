# Secrets und lokale Konfiguration
.env

# Laufzeitdaten der Container
/server/
/admin-data/

# Eine Vorgabedatei fuer die Kommandozeile ist Sache der Installation, nicht
# des Repositorys (siehe beispiele/).
/config/

# Die Slice v1.5.735 und ihre Uebersetzung liegen im Repository: die Tests
# brauchen sie, und sie ist die Referenz, gegen die alles geprueft wird. Das
# Image erzeugt seine eigene aus dem Tag in MUMBLE_VERSION.
/admin/slice/*.pyc

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/

# Beim Image-Bau geladen, nicht im Repository.
/admin/static/vendor/

# Eigene Zertifizierungsstellen sind umgebungsspezifisch und gehoeren nicht
# ins Repository -- nur die Beschreibung, wie man sie ablegt.
admin/ca/*
!admin/ca/README.md
