# Secrets und lokale Konfiguration
.env

# Laufzeitdaten der Container
/server/
/admin-data/

# Von slice2py erzeugt -- haengt an MUMBLE_VERSION und wird beim Bau erstellt
/admin/slice/MumbleServer.ice
/admin/slice/MumbleServer_ice.py
/admin/slice/MumbleServer/
/admin/slice/*.pyc

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/

# Beim Image-Bau geladen, nicht im Repository.
/admin/static/vendor/

# Eigene Zertifizierungsstellen sind umgebungsspezifisch und gehoeren nicht
# ins Repository -- nur die Beschreibung, wie man sie ablegt.
admin/ca/*
!admin/ca/README.md
